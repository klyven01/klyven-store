# Copy this file to .env for local development, and set the same
# keys in Netlify: Site settings -> Environment variables.
#
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the browser.
# Never put a real secret (like a payment gateway SECRET key) behind a
# VITE_ prefix — anything with VITE_ ends up in the public JS bundle.

# --- Supabase (recommended free database for orders + admin) ---
# These two Supabase values are meant to be public (protected by Row Level
# Security policies on the database side) — see /supabase/schema.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Razorpay (or another gateway) — for when you connect real online payment ---
# Only the PUBLIC key ever goes in frontend code. The SECRET key must live
# only on a server (e.g. a Netlify Function), never here.
VITE_RAZORPAY_KEY_ID=
